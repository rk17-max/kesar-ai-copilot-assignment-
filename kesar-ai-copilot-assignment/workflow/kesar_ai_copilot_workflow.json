      "ai_tool": [
        [
          {
            "node": "AI Support Agent (with Tools)",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Tool: search_faq": {
      "ai_tool": [
        [
          {
            "node": "AI Support Agent (with Tools)",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets: Create/Update Ticket": {
      "main": [
        [
          {
            "node": "Google Sheets: Append Audit Log",
            "type": "main",
